{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read https://deno.land/std@0.157.0/http/file_server.ts dist/"
  },
  "lint": {
    "indent-width": 2,
    "rules": {
      "tags": ["recommended"],
      "no-explicit-any": false
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:react",
    "jsxImportSourceTypes": "npm:@types/react",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "noImplicitAny": false
  },
  "imports": {
    "@smastrom/react-rating": "npm:@smastrom/react-rating@^1.5.0",
    "@types/axios": "npm:@types/axios@^0.14.0",
    "@types/react": "npm:@types/react@^18.3.11",
    "@types/react-bootstrap": "npm:@types/react-bootstrap@^1.0.1",
    "@types/react-dom": "npm:@types/react-dom@^18.3.0",
    "@types/react-icons": "npm:@types/react-icons@^3.0.0",
    "ag-grid-community": "npm:ag-grid-community@^32.2.2",
    "ag-grid-react": "npm:ag-grid-react@^32.2.2",
    "axios": "npm:axios@^1.7.7",
    "bootstrap": "npm:bootstrap@^5.3.3",
    "fuse.js": "npm:fuse.js@^7.1.0",
    "jotai": "npm:jotai@^2.10.0",
    "leaflet": "npm:leaflet@^1.9.4",
    "leaflet-geosearch": "npm:leaflet-geosearch@^4.2.0",
    "lodash": "npm:lodash@^4.17.21",
    "react": "npm:react@^19.0.0",
    "react-bootstrap": "npm:react-bootstrap@^2.10.7",
    "react-dom": "npm:react-dom@^19.0.0",
    "react-helmet": "npm:react-helmet@^6.1.0",
    "react-icons": "npm:react-icons@^5.3.0",
    "react-image": "npm:react-image@^4.1.0",
    "react-images-uploading": "npm:react-images-uploading@^3.1.7",
    "react-leaflet": "npm:react-leaflet@^5.0.0-rc.2",
    "react-player": "npm:react-player@^2.16.0",
    "react-router-dom": "npm:react-router-dom@^6.26.2",
    "react-select": "npm:react-select@^5.9.0",
    "react-spinners": "npm:react-spinners@^0.14.1",
    "react-spotify-embed": "npm:react-spotify-embed@^2.0.4",
    "react-time-picker": "npm:react-time-picker@^7.0.0",
    "react-toastify": "npm:react-toastify@^11.0.3",
    "spinners-react": "npm:spinners-react@^1.0.10",
    "styled-components": "npm:styled-components@^6.1.13"
  }
}
